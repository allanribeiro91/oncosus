# Copie para .env nesta pasta (backend/rag) ou na raiz do repositório oncosus-novo.
# Modelo: crie com o Modelfile na raiz do repo: .\create-oncosus-ollama.ps1
# Se `ollama run oncosus-llm` ficar no spinner: pare a API (libera RAM), teste de novo.
# Fallback sem modelo custom: ONCOSUS_OLLAMA_MODEL=llama3.2:1b
ONCOSUS_OLLAMA_MODEL=oncosus-llm

# Embeddings: não precisa mudar se a API já sobe. Deixe em branco = mesmo modelo do step_4 (e5-base).
# Só use outro embedding se aparecer erro 1455 / paginação; aí reindexa (ver README).
# ONCOSUS_EMBEDDING_MODEL=

# Segundos máximos esperando o Ollama (padrão 660). Front usa ~720s — mantenha front > este valor.
# ONCOSUS_OLLAMA_TIMEOUT_SEC=660

# Máximo de tokens na resposta (padrão 512). Menor = mais rápido em CPU.
# ONCOSUS_OLLAMA_NUM_PREDICT=512

# RAM no Ollama (padrão no código já é conservador: ctx 512, batch 128, top_k 6)
# Se ainda der "unable to allocate CPU buffer", baixe mais:
# ONCOSUS_OLLAMA_NUM_CTX=512
# ONCOSUS_OLLAMA_NUM_BATCH=64
# ONCOSUS_TOP_K=4
# ONCOSUS_FINAL_K=2
